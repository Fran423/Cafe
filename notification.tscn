[sub_resource type="GDScript" id="GDScript_gk8rk"]
script/source = "extends Label

@export var added_position : Vector2
@onready var og_pos : Vector2 = global_position
func _process(_delta: float) -> void:
	global_position = og_pos + added_position - Vector2(size/2)

func cobrar(price):
	text = str('-$',\"%.2f\"%price)
"


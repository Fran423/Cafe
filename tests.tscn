[sub_resource type="GDScript" id="GDScript_4j8f0"]
script/source = "extends Node2D


@onready var kitchen_viewport : SubViewport = $Kitchen
@onready var kitchen_texture : TextureRect = $KitchenTexture
@onready var counter_viewport : SubViewport = $Counter
@onready var counter_texture : TextureRect = $CounterTexture
func _ready() -> void:
	Main.connect('object_placed',object_placed)
func object_placed(pos,object : Node):
	if object.has_method('update_area'):
		object.update_area()
	var objective_positions : Array
	var resized_positions : Array[Rect2]
	if object == $Kitchen/Cazo:
		objective_positions = [$Kitchen/MolinilloCafe,$Kitchen/Cafetera]
	elif object == $Kitchen/Tamper:
		objective_positions = [$Kitchen/Cazo]
	elif object.is_in_group('Envases'):
		objective_positions = [$Kitchen/Cafetera]
	
	for area : Node in objective_positions:
		resized_positions.append(Rect2(
			area.position/kitchen_texture.get_rect().size + kitchen_texture.global_position,
			area.area.size/get_viewport().get_visible_rect().size*kitchen_texture.get_rect().size))
	if !objective_positions.is_empty():
		for posi : Node in objective_positions:
			if posi.area.has_point(pos):
				location_reached(object,posi)
				print(object.name,' llevado a ',posi.name)
				return
		object.return_to_og_location()
		print(object.name,' soltado')
	else:
		object.return_to_og_location()
		print(object.name,' soltado')

func _input(event: InputEvent) -> void:
	if event is InputEventMouse:
		var mouse_pos = kitchen_texture.get_local_mouse_position()
		var viewport_pos : Vector2 = mouse_pos * (
		Vector2(kitchen_viewport.size) / kitchen_texture.size)
		var new_event := event.duplicate()
		new_event.position = viewport_pos + kitchen_texture.position/kitchen_texture.get_rect().size
		kitchen_viewport.push_input(new_event)
		
		var mouse_pos_counter = counter_texture.get_local_mouse_position()
		var viewport_counter : Vector2 = mouse_pos_counter * (
		Vector2(counter_viewport.size) / counter_texture.size)
		var new_event_counter := event.duplicate()
		new_event_counter.position = viewport_counter + counter_texture.position/counter_texture.get_rect().size
		counter_viewport.push_input(new_event_counter)

func location_reached(object,destination):
	object.use(destination)
"

